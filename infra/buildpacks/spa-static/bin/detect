#!/usr/bin/env bash
set -euo pipefail

is_spa=0
if [ -f angular.json ] || [ -f vite.config.js ] || [ -f vite.config.ts ] || [ -f vite.config.mjs ] || [ -f svelte.config.js ] || [ -f svelte.config.ts ]; then
  is_spa=1
fi
if [ "$is_spa" = 0 ]; then
  for f in gatsby-config.js gatsby-config.ts docusaurus.config.js docusaurus.config.ts .eleventy.js eleventy.config.js eleventy.config.cjs; do
    [ -f "$f" ] && is_spa=1
  done
  for f in next.config.js next.config.mjs next.config.ts; do
    if [ -f "$f" ] && grep -qE "output[[:space:]]*:[[:space:]]*['\"]export['\"]" "$f"; then
      is_spa=1
    fi
  done
  # Lume (SSG para Deno)
  if [ -f _config.ts ] || [ -f _config.js ] || [ -f _config.jsx ] || [ -f _config.tsx ]; then
    is_spa=1
  fi
  # Deno SSG genérico: deno.json com task build e SEM start task
  if [ "$is_spa" = 0 ] && { [ -f deno.json ] || [ -f deno.jsonc ]; }; then
    f="deno.json"; [ -f deno.jsonc ] && f="deno.jsonc"
    if grep -qE '"build"[[:space:]]*:' "$f" && ! grep -qE '"start"[[:space:]]*:' "$f"; then
      is_spa=1
    fi
  fi
fi
if [ "$is_spa" = 0 ] && [ -f package.json ]; then
  if grep -qE '"start:prod"[[:space:]]*:' package.json || grep -qE '"@nestjs/(core|common)"[[:space:]]*:' package.json; then
    echo "aether/spa-static: server application marker found"
    exit 100
  fi
  case "$(cat package.json)" in
    *'"@angular/core"'*|*'"react-scripts"'*|*'"vue-cli-service"'*|*'"@vue/cli-service"'*|*'"vite"'*|*'"@vitejs/plugin-react"'*|*'"astro"'*) is_spa=1 ;;
  esac
fi
if [ "$is_spa" = 0 ]; then
  echo "aether/spa-static: no SPA markers found"
  exit 100
fi

PLAN_PATH="${CNB_BUILD_PLAN_PATH:-${1:-}}"
if [ -n "$PLAN_PATH" ]; then
  : > "$PLAN_PATH"
fi
echo "aether/spa-static: SPA detected — building static output"
