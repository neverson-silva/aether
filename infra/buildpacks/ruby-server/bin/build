#!/usr/bin/env bash
set -euo pipefail

LAYERS_DIR="$1"
PLATFORM_DIR="$2"
PLAN_PATH="$3"

ruby_layer="$LAYERS_DIR/ruby"
app_layer="$LAYERS_DIR/ruby-app"
mkdir -p "$ruby_layer/bin" "$app_layer/bin"
export PATH="$ruby_layer/bin:$PATH"

echo "aether/ruby-server: instalando Ruby via apt (Ubuntu LTS)..."
apt-get update -qq >/dev/null 2>&1 || true
apt-get install -y -qq ruby-full build-essential libssl-dev pkg-config >/dev/null 2>&1
cp -a /usr/bin/ruby "$ruby_layer/bin/" 2>/dev/null || true
ruby --version || { echo "aether/ruby-server: ruby não instalado"; exit 1; }
gem --version

# ---------------------------------------------------------------------------
# Bundler + gems
# ---------------------------------------------------------------------------
gem install bundler --no-document >/dev/null 2>&1 || true

if [ -f /workspace/Gemfile ]; then
  cd /workspace
  export BUNDLE_PATH="$ruby_layer/bundle"
  export BUNDLE_WITHOUT="development:test"
  bundle config set --local path "$ruby_layer/bundle" >/dev/null 2>&1 || true
  bundle config set --local without "development:test" >/dev/null 2>&1 || true
  if [ -f Gemfile.lock ]; then
    bundle config set --local deployment true >/dev/null 2>&1 || true
  fi
  echo "aether/ruby-server: bundle install (sem dev/test)..."
  bundle install --quiet 2>/tmp/bundlerr || { cat /tmp/bundlerr | tail -6; exit 1; }
fi

# ---------------------------------------------------------------------------
# Server: puma (preferido) > rackup > rack > ruby direto
# ---------------------------------------------------------------------------
start_line="exec ruby -e 'print'"
HAS_PUMA=0; HAS_RACKUP=0; IS_RAILS=0
if [ -f Gemfile.lock ]; then
  grep -qE '^\s*puma ' Gemfile.lock && HAS_PUMA=1
  grep -qE '^\s*rackup ' Gemfile.lock && HAS_RACKUP=1
  grep -qE '^\s*rails ' Gemfile.lock && IS_RAILS=1
fi

if [ "$IS_RAILS" = 1 ]; then
  echo "aether/ruby-server: Rails detectado — precompilando assets..."
  RAILS_ENV=production bundle exec rake assets:precompile >/dev/null 2>&1 || true
fi

if [ "$HAS_PUMA" = 1 ]; then
  start_line='export RAILS_ENV=production; export RACK_ENV=production; export SECRET_KEY_BASE="${SECRET_KEY_BASE:-$(ruby -rsecurerandom -e "puts SecureRandom.hex(64)")}"; exec bundle exec puma -b tcp://0.0.0.0:${PORT:-8080} -e production'
elif [ "$HAS_RACKUP" = 1 ] || [ -f /workspace/config.ru ]; then
  start_line='export RACK_ENV=production; exec bundle exec rackup -o 0.0.0.0 -p ${PORT:-8080}'
elif [ -f /workspace/config.ru ]; then
  start_line='export RACK_ENV=production; exec bundle exec rackup -o 0.0.0.0 -p ${PORT:-8080}'
elif [ -f /workspace/app.rb ]; then
  start_line='export RACK_ENV=production; exec ruby app.rb'
elif [ -f /workspace/app/main.rb ]; then
  start_line='export RACK_ENV=production; exec ruby app/main.rb'
else
  start_line='export RACK_ENV=production; exec bundle exec rackup -o 0.0.0.0 -p ${PORT:-8080}'
fi

cat > "$app_layer/bin/start.sh" <<SH
#!/bin/sh
set -e
$start_line
SH
chmod +x "$app_layer/bin/start.sh"

cat > "$ruby_layer.toml" <<'EOF'
[types]
  build = true
  launch = true
EOF

cat > "$app_layer.toml" <<'EOF'
[types]
  build = true
  launch = true
EOF

cat > "$LAYERS_DIR/launch.toml" <<'EOF'
[[processes]]
  type = "web"
  command = ["start.sh"]
  default = true
EOF

echo "aether/ruby-server: web process pronto (puma/rackup)"
