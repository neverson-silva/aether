#!/usr/bin/env bash
set -euo pipefail

LAYERS_DIR="$1"
PLATFORM_DIR="$2"
PLAN_PATH="$3"

case "$(uname -m)" in
  x86_64|amd64)  ARCH="x86_64" ;;
  aarch64|arm64) ARCH="aarch64" ;;
  *) echo "aether/php-server: unsupported arch $(uname -m)"; exit 1 ;;
esac

# ---------------------------------------------------------------------------
# Instala PHP: binário estático (static-php.dev) para 8.x; PPA ondrej para 7.x
# ---------------------------------------------------------------------------
php_layer="$LAYERS_DIR/php"
app_layer="$LAYERS_DIR/php-app"
mkdir -p "$php_layer/bin" "$app_layer/bin"
export PATH="$php_layer/bin:$PATH"

# ---------------------------------------------------------------------------
# Versão do PHP a partir do constraint do composer (require.php)
# ---------------------------------------------------------------------------
PHP_MAJOR="8"
if [ -f /workspace/composer.json ]; then
  constraint="$(grep -oE '"php"[[:space:]]*:[[:space:]]*"[^"]*"' /workspace/composer.json | head -1 | sed -E 's/.*:[[:space:]]*"//; s/"$//' || true)"
  case "$constraint" in
    *'7.'*) PHP_MAJOR="7" ;;
    *'8.'*) PHP_MAJOR="8" ;;
    *'^'*'5'*|*'^'*'6'*) PHP_MAJOR="7" ;;
  esac
  echo "aether/php-server: require.php=\"${constraint:-}"\" -> major $PHP_MAJOR
fi

install_php_static() {
  local major="$1" dest="$2"
  local ver
  ver="$(curl -fsSL "https://dl.static-php.dev/static-php-cli/common/" \
    | grep -oE "php-${major}\.[0-9]+\.[0-9]+-cli-linux-${ARCH}\.tar\.gz" | sort -uV | tail -1 || true)"
  [ -n "$ver" ] || { echo "aether/php-server: nenhuma versão ${major}.x estática disponível"; return 1; }
  echo "aether/php-server: baixando PHP estático $ver ($ARCH)..."
  curl -fsSLo /tmp/php.tgz "https://dl.static-php.dev/static-php-cli/common/$ver"
  tar -xzf /tmp/php.tgz -C "$dest"
  rm -f /tmp/php.tgz
  return 0
}

install_php_ondrej() {
  # PPA ondrej/php — oferece 7.4+ em qualquer Ubuntu recente
  apt-get update -qq >/dev/null 2>&1 || true
  apt-get install -y -qq software-properties-common >/dev/null 2>&1 || true
  LC_ALL=C.UTF-8 add-apt-repository -y ppa:ondrej/php >/dev/null 2>&1 || true
  apt-get update -qq >/dev/null 2>&1 || true
  local ver="$1"
  apt-get install -y -qq "php${ver}-cli" "php${ver}-mbstring" "php${ver}-xml" "php${ver}-curl" \
    "php${ver}-sqlite3" "php${ver}-mysql" "php${ver}-pgsql" "php${ver}-gd" "php${ver}-intl" \
    "php${ver}-bcmath" "php${ver}-zip" >/dev/null 2>&1
  if [ -f "/usr/bin/php${ver}" ]; then
    ln -sf "/usr/bin/php${ver}" "$php_layer/bin/php"
  fi
}

case "$PHP_MAJOR" in
  7)
    echo "aether/php-server: PHP 7.x via PPA ondrej (php7.4)..."
    install_php_ondrej 7.4
    ;;
  *)
    if ! install_php_static "$PHP_MAJOR" "$php_layer/bin"; then
      # fallback: 8.3 via apt do Ubuntu
      echo "aether/php-server: fallback apt php8.3-cli"
      apt-get update -qq >/dev/null 2>&1 || true
      apt-get install -y -qq php8.3-cli php8.3-mbstring php8.3-xml php8.3-curl \
        php8.3-sqlite3 php8.3-mysql php8.3-pgsql php8.3-gd php8.3-intl php8.3-bcmath php8.3-zip \
        >/dev/null 2>&1 || true
      if [ -f /usr/bin/php ]; then
        cp -a /usr/bin/php "$php_layer/bin/php"
      fi
    fi
    ;;
esac

[ -x "$php_layer/bin/php" ] || { echo "aether/php-server: PHP não instalado"; exit 1; }
php --version | head -1

# ---------------------------------------------------------------------------
# Composer (determinístico: lockfile + optimize-autoloader)
# ---------------------------------------------------------------------------
if [ -f /workspace/composer.json ]; then
  echo "aether/php-server: instalando Composer..."
  curl -fsSLo /tmp/composer-setup.php https://getcomposer.org/installer
  php /tmp/composer-setup.php --install-dir="$php_layer/bin" --filename=composer --quiet
  rm -f /tmp/composer-setup.php
  export COMPOSER_HOME="$php_layer/.composer"
  export COMPOSER_NO_INTERACTION=1
  cd /workspace
  if [ -f composer.lock ]; then
    composer install --no-dev --no-interaction --no-progress --prefer-dist --optimize-autoloader --classmap-authoritative
  else
    composer install --no-interaction --no-progress --prefer-dist --optimize-autoloader
  fi

  # Framework profile: Laravel/Symfony caches
  if [ -f /workspace/artisan ]; then
    echo "aether/php-server: Laravel detectado — warmup de caches..."
    php artisan config:cache   >/dev/null 2>&1 || true
    php artisan route:cache    >/dev/null 2>&1 || true
    php artisan view:cache     >/dev/null 2>&1 || true
    php artisan event:cache    >/dev/null 2>&1 || true
  elif [ -f /workspace/bin/console ]; then
    echo "aether/php-server: Symfony detectado — warmup de cache..."
    php bin/console cache:warmup >/dev/null 2>&1 || true
  fi
fi

# ---------------------------------------------------------------------------
# OPcache (performance) — php.ini dedicado na layer
# ---------------------------------------------------------------------------
mkdir -p "$php_layer/etc"
cat > "$php_layer/etc/php.ini" <<'EOF'
; Aether — performance tuning para produção
memory_limit=256M
opcache.enable=1
opcache.enable_cli=1
opcache.memory_consumption=192
opcache.interned_strings_buffer=16
opcache.max_accelerated_files=20000
opcache.validate_timestamps=0
opcache.jit=tracing
opcache.jit_buffer_size=64M
realpath_cache_size=4096K
realpath_cache_ttl=600
expose_php=0
EOF
export PHP_INI_SCAN_DIR=""
export PHPRC="$php_layer/etc"

# ---------------------------------------------------------------------------
# Start: php -S com router (Laravel/Symfony public/index.php; WP na raiz)
# ---------------------------------------------------------------------------
start_line="exec php -S 0.0.0.0:\${PORT:-8080}"
if [ -f /workspace/public/index.php ]; then
  start_line="exec php -S 0.0.0.0:\${PORT:-8080} -t public public/index.php"
elif [ -f /workspace/index.php ]; then
  start_line="exec php -S 0.0.0.0:\${PORT:-8080}"
elif [ -f /workspace/artisan ]; then
  start_line="exec php artisan serve --host=0.0.0.0 --port=\${PORT:-8080}"
fi

cat > "$app_layer/bin/start.sh" <<SH
#!/bin/sh
set -e
export PHPRC="$LAYERS_DIR/php/etc"
export PHP_INI_SCAN_DIR=""
$start_line
SH
chmod +x "$app_layer/bin/start.sh"

cat > "$php_layer.toml" <<'EOF'
[types]
  build = true
  launch = true
EOF

cat > "$app_layer.toml" <<'EOF'
[types]
  build = true
  launch = true
EOF

cat > "$LAYERS_DIR/launch.toml" <<'EOF'
[[processes]]
  type = "web"
  command = ["start.sh"]
  default = true
EOF

echo "aether/php-server: web process pronto (php -S, PORT=\$PORT)"
