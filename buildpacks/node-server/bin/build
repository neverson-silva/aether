#!/usr/bin/env bash
set -euo pipefail

LAYERS_DIR="$1"
PLATFORM_DIR="$2"
PLAN_PATH="$3"

node_layer="$LAYERS_DIR/node"
app_layer="$LAYERS_DIR/node-app"
mkdir -p "$node_layer" "$app_layer/bin"

NODE_MAJOR="22"
if [ -f /workspace/package.json ]; then
  major="$(grep -oE '"engines"[^}]*"node"[[:space:]]*:[[:space:]]*"[^"]*"' /workspace/package.json | grep -oE '[0-9]+' | head -1 || true)"
  case "$major" in
    ''|0) ;;
    [0-9]*) NODE_MAJOR="$major" ;;
  esac
fi

NODE_VER="$(curl -fsSL https://nodejs.org/dist/index.json | grep -oE "\"version\":\"v${NODE_MAJOR}\.[0-9]+\.[0-9]+\"" | head -1 | grep -oE 'v[0-9.]+' | tr -d 'v' || true)"
NODE_VER="${NODE_VER:-22.19.4}"

echo "aether/node-server: installing Node v$NODE_VER (engines.node major $NODE_MAJOR)..."
curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v$NODE_VER/node-v$NODE_VER-linux-x64.tar.xz"
tar -xJf /tmp/node.tar.xz -C "$node_layer" --strip-components=1
rm -f /tmp/node.tar.xz
export PATH="$node_layer/bin:$PATH"
node --version && npm --version

cd /workspace

PM="npm"
if [ -f pnpm-lock.yaml ]; then
  PM="pnpm"
  npm install -g pnpm@latest --no-audit --no-fund >/dev/null 2>&1
elif [ -f yarn.lock ]; then
  PM="yarn"
  npm install -g yarn@latest --no-audit --no-fund >/dev/null 2>&1
fi

case "$PM" in
  pnpm)
    pnpm install --frozen-lockfile
    ;;
  yarn)
    yarn install --frozen-lockfile --non-interactive
    ;;
  *)
    if [ -f package-lock.json ]; then
      npm ci --no-audit --no-fund
    else
      npm install --no-audit --no-fund
    fi
    ;;
esac

if grep -qE '"build"[[:space:]]*:' package.json; then
  echo "aether/node-server: running $PM run build..."
  case "$PM" in
    pnpm) pnpm run build ;;
    yarn) yarn run build ;;
    *) npm run build ;;
  esac
fi

script=""
value=""
for cand in start:prod start; do
  v="$(grep -oE "\"$cand\"[[:space:]]*:[[:space:]]*\"[^\"]*\"" package.json | head -1 | sed -E 's/.*:[[:space:]]*"//; s/"$//' || true)"
  if [ -n "$v" ]; then
    script="$cand"
    value="$v"
    break
  fi
done
[ -n "$script" ] || { echo "aether/node-server: sem start script"; exit 1; }
echo "aether/node-server: start script $script -> $value"

if [ "${value#node }" != "$value" ]; then
  rest="${value#node }"
  cat > "$app_layer/bin/start.sh" <<SH
#!/bin/sh
set -e
exec node $rest
SH
else
  cat > "$app_layer/bin/start.sh" <<SH
#!/bin/sh
set -e
exec $PM run $script
SH
fi
chmod +x "$app_layer/bin/start.sh"

cat > "$node_layer.toml" <<'EOF'
[types]
  build = true
  launch = true
EOF

cat > "$app_layer.toml" <<'EOF'
[types]
  build = true
  launch = true
EOF

cat > "$LAYERS_DIR/launch.toml" <<'EOF'
[[processes]]
  type = "web"
  command = ["start.sh"]
  default = true
EOF

echo "aether/node-server: web process -> $script ($value, pm=$PM)"
