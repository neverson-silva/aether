DEV_MODE=true

DATABASE_NAME=aether_dev
DATABASE_USER=aether
DATABASE_PASSWORD=replace-with-a-long-random-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=1543

AETHER_PUBLIC_URL=
AETHER_FREE_DOMAIN_PROVIDER=nip.io
AETHER_PUBLISHED_NETWORK=aether-workload-host
AETHER_NATS_USER=aether
AETHER_NATS_PASSWORD=replace-with-a-long-random-password

AETHER_DOCKER_HOST=tcp://docker-socket-proxy:2375
AETHER_REQUIRE_IMAGE_SIGNATURES=true
AETHER_REQUIRE_IMAGE_DIGESTS=true
AETHER_COSIGN_PUBLIC_KEY=/run/secrets/aether-cosign.pub
AETHER_RESTORE_QUOTA_BYTES=4294967296
AETHER_TRAEFIK_IMAGE=traefik:v3.2@sha256:replace-with-verified-digest
AETHER_CNB_BUILDER=pack.local/builder/node-spa@sha256:replace-with-verified-digest
